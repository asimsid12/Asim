# ── Splendid Accounts API ────────────────────────────────────────────────────
# Get these from Splendid: Settings → API / Integrations
SPLENDID_API_KEY=your-api-key
SPLENDID_API_SECRET=your-api-secret
SPLENDID_APP_ID=your-app-id

# Your company slug — visible in your Splendid URL after login
# e.g. https://app.splendidaccounts.com/barostudio → slug is "barostudio"
SPLENDID_TENANT=your-company-slug

# Branch ID — from GET /Companies response (branches array → id)
SPLENDID_BRANCH_ID=1

# Warehouse ID — from GET /{slug}/warehouses (use Default warehouse id)
SPLENDID_WAREHOUSE_ID=12345

# Default Product ID — create one generic product in Splendid called
# "Clothing Item" and paste its ID here. Used when item isn't in catalog.
SPLENDID_DEFAULT_PRODUCT_ID=67890

# (Optional) GL account ID for bank/JazzCash/Easypaisa payments
# From GET /{slug}/{branchId}/SystemAccounts — find your bank account
SPLENDID_BANK_ACCOUNT_ID=

# ── Google Sheets ────────────────────────────────────────────────────────────
GOOGLE_SHEET_ID=your-google-sheet-id
GOOGLE_SERVICE_ACCOUNT_KEY=./service-account-key.json
