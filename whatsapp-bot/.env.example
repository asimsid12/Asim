# Your WhatsApp number in international format — no + or spaces
# e.g. if your number is 0300-1234567, enter 923001234567
OWNER_PHONE=923001234567

# Claude API key from console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Google Sheets — get the ID from the sheet URL
# https://docs.google.com/spreadsheets/d/THIS_IS_THE_ID/edit
GOOGLE_SHEET_ID=your-sheet-id-here

# Path to your Google Service Account JSON key file
GOOGLE_SERVICE_ACCOUNT_KEY=./service-account-key.json

# ── Splendid Accounts API (optional — enables "Invoice BS-XXXX" command) ─────
# Get these from Splendid: Settings → API / Integrations
SPLENDID_API_KEY=
SPLENDID_API_SECRET=
SPLENDID_APP_ID=
SPLENDID_TENANT=
SPLENDID_BRANCH_ID=
SPLENDID_WAREHOUSE_ID=
SPLENDID_DEFAULT_PRODUCT_ID=
SPLENDID_BANK_ACCOUNT_ID=
