# ── WhatsApp Bot ─────────────────────────────────────────────────────────────
# Your WhatsApp number in international format (no + or spaces)
# e.g. 0300-1234567 → 923001234567
OWNER_PHONE=923001234567

# ── AI APIs ───────────────────────────────────────────────────────────────────
# Claude (command parsing)  — console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI Whisper (voice transcription) — platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# ── Google Sheets ─────────────────────────────────────────────────────────────
# From the sheet URL: docs.google.com/spreadsheets/d/<THIS_ID>/edit
GOOGLE_SHEET_ID=your-sheet-id-here

# Path to your Google Service Account JSON key file
# Create one at: console.cloud.google.com → IAM → Service Accounts
GOOGLE_SERVICE_ACCOUNT_KEY=./service-account-key.json

# ── Splendid Accounts API ─────────────────────────────────────────────────────
# Get these from Splendid: Settings → API / Integrations
SPLENDID_API_KEY=
SPLENDID_API_SECRET=
SPLENDID_APP_ID=
SPLENDID_TENANT=           # your company slug in Splendid URLs
SPLENDID_BRANCH_ID=
SPLENDID_WAREHOUSE_ID=
SPLENDID_DEFAULT_PRODUCT_ID=   # fallback product for items not in catalog
SPLENDID_CURRENCY_ID=1         # 1 = PKR

# GL account IDs — find these in Splendid → Chart of Accounts
SPLENDID_BANK_ACCOUNT_ID=      # account where customer payments land (Soneri Bank - Baro)

# ── Google Health API ─────────────────────────────────────────────────────────
# console.cloud.google.com → enable "Google Health API" → Credentials →
# OAuth client ID → Web application, redirect URI http://127.0.0.1:3000/callback
GOOGLE_HEALTH_CLIENT_ID=
GOOGLE_HEALTH_CLIENT_SECRET=
