{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "google-health-connector",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",

  // Required for Client ID Metadata Document support (SSRF-safe outbound fetches).
  "compatibility_flags": ["global_fetch_strictly_public"],

  "kv_namespaces": [
    // Created by `npx wrangler kv namespace create <NAME>` — paste the ids here.
    { "binding": "OAUTH_KV",  "id": "REPLACE_WITH_OAUTH_KV_ID" },
    { "binding": "HEALTH_KV", "id": "REPLACE_WITH_HEALTH_KV_ID" }
  ],

  "vars": {
    // Comma-separated Google accounts allowed to connect. Leave empty to allow any.
    "ALLOWED_EMAILS": ""
  },

  "observability": { "enabled": true }
}
